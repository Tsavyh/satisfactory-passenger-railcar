int NextHandle=1;
bool InProduction=false;
int ForbiddenWrites=0, ProductionOwnAdds=0, ProductionOwnRemoves=0, CompletedAddCallbacks=0, CompletedRemoveCallbacks=0;
struct Origin {bool old; explicit Origin(bool value):old(InProduction){InProduction=value;} ~Origin(){InProduction=old;}};
