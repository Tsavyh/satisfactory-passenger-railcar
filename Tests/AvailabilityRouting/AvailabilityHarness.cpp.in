template<class T> struct TSubclassOf { UClass* value=nullptr; TSubclassOf()=default; TSubclassOf(UClass* p):value(p){} UClass* Get()const{return value;} explicit operator bool()const{return value!=nullptr;} bool operator==(const TSubclassOf& x)const{return value==x.value;} };
template<class T> using TObjectPtr=T*;
int WeakSlots=0;
template<class T> struct TWeakObjectPtr {T* p=nullptr;TWeakObjectPtr(){++WeakSlots;}TWeakObjectPtr(T* x):p(x){++WeakSlots;}TWeakObjectPtr(const TWeakObjectPtr& x):p(x.p){++WeakSlots;}~TWeakObjectPtr(){--WeakSlots;} T* Get()const{return IsValid(p)?p:nullptr;}void Reset(){p=nullptr;}};
template<class T> struct TArray:std::vector<T> {using std::vector<T>::vector;void Add(T x){this->push_back(x);} template<class F>void RemoveAll(F fn){this->erase(std::remove_if(this->begin(),this->end(),fn),this->end());} void Empty(){this->clear();}};
