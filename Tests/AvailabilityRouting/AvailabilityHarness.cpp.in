template<class T> UClass* LoadClass(UObject*, const char* path){++Loads; if(std::string(path)!="/Game/FactoryGame/Recipes/Vehicle/Train/Recipe_FreightWagon.Recipe_FreightWagon_C") throw std::runtime_error("wrong native path"); return Resolve?&FreightClass:nullptr;}
enum class EGameObjectRegistrationFlags {Removed=1, Unregistered=2};
EGameObjectRegistrationFlags operator|(EGameObjectRegistrationFlags a,EGameObjectRegistrationFlags b){return EGameObjectRegistrationFlags(int(a)|int(b));}
struct FGameObjectRegistration {UClass* RegisteredObject=nullptr; FName OwnedByModReference; bool removed=false; bool HasAnyFlags(EGameObjectRegistrationFlags)const{return removed;} };
struct UModContentRegistry: UObject {int calls=0; bool readback=true, wrongOwner=false, wrongObject=false, removed=false; static UModContentRegistry* current; static UModContentRegistry* Get(UWorld*){return current;} void RegisterRecipe(FName owner,TSubclassOf<UFGRecipe> recipe){++calls; if(owner.value!="TsabsPassengerWagon"||recipe.Get()!=&OwnClass)throw std::runtime_error("foreign registration");} bool GetRecipeInfo(TSubclassOf<UFGRecipe>,FGameObjectRegistration& out){out.RegisteredObject=wrongObject?&OtherClass:&OwnClass; out.OwnedByModReference=FName(wrongOwner?"Other":"TsabsPassengerWagon"); out.removed=removed; return readback;} };
UModContentRegistry* UModContentRegistry::current=nullptr;
using Hook = std::function<void(AFGRecipeManager*,const TArray<TSubclassOf<UFGRecipe>>&)>;
// Native SML boundary: LIVE reference traversal, no handler snapshots.
// On illegal mutation record the defect and defer destructive erase solely to
// avoid invoking C++ UB in a diagnostic RED. The test must fail on the record.
struct HookTable {
 std::vector<std::pair<int,std::shared_ptr<Hook>>> entries; int active=0; std::vector<int> forbiddenPending;
 auto begin(){return entries.begin();} auto end(){return entries.end();}
 bool empty()const{return entries.empty();} auto size()const{return entries.size();}
 Hook& operator[](int id){entries.emplace_back(id,std::make_shared<Hook>());return *entries.back().second;}
 void erase(int id){entries.erase(std::remove_if(entries.begin(),entries.end(),[id](auto& e){return e.first==id;}),entries.end());}
};
HookTable AddHooks,RemoveHooks;
int ActiveUnsubscribes=0,ActiveSubscribes=0,DestroyedLists=0,Subscriptions=0,Unsubscriptions=0;

FDelegateHandle Subscribe(const char* method,Hook cb){auto& hooks=std::string(method).find("Remove")!=std::string::npos?RemoveHooks:AddHooks;if(hooks.active){++ActiveSubscribes;throw std::runtime_error("subscription mutates active native list");}++Subscriptions;FDelegateHandle h{NextHandle++};hooks[h.id]=cb;return h;}
void Unsubscribe(const char* method,FDelegateHandle h){auto& hooks=std::string(method).find("Remove")!=std::string::npos?RemoveHooks:AddHooks;++Unsubscriptions;if(hooks.active){++ActiveUnsubscribes;hooks.forbiddenPending.push_back(h.id);std::cout<<"ACTIVE_LIST_UNSUBSCRIBE "<<method<<"\n";return;}hooks.erase(h.id);if(hooks.empty())++DestroyedLists;}
#define SUBSCRIBE_METHOD_AFTER(Method,...) Subscribe(#Method,__VA_ARGS__)
#define UNSUBSCRIBE_METHOD(Method,Handle) Unsubscribe(#Method,Handle)
void Fire(HookTable& hooks,AFGRecipeManager* manager,const TArray<TSubclassOf<UFGRecipe>>& args){++hooks.active;for(const auto& [id,cb]:hooks){Origin origin(true);if(&hooks==&AddHooks)++CompletedAddCallbacks;else ++CompletedRemoveCallbacks;(*cb)(manager,args);}if(--hooks.active==0){for(int id:hooks.forbiddenPending)hooks.erase(id);hooks.forbiddenPending.clear();}}

struct CleanupDelegate { std::map<int,std::function<void(UWorld*,bool,bool)>> handlers; template<class T> FDelegateHandle AddUObject(T* object,void(T::*fn)(UWorld*,bool,bool)){FDelegateHandle h{NextHandle++};handlers[h.id]=[object,fn](UWorld* w,bool a,bool b){if(IsValid(object))(object->*fn)(w,a,b);};return h;} void Remove(FDelegateHandle h){handlers.erase(h.id);} void Broadcast(UWorld* w){auto c=handlers;for(auto& [id,cb]:c)if(handlers.count(id))cb(w,true,true);} };
struct FWorldDelegates {static CleanupDelegate OnWorldCleanup;};
CleanupDelegate FWorldDelegates::OnWorldCleanup;
template<class T> struct TGuardValue {T& ref; T old; TGuardValue(T& r,T val):ref(r),old(r){ref=val;} ~TGuardValue(){ref=old;} };
struct AFGRecipeManager: UObject {
 UWorld* world=nullptr; bool authority=true, reject=false; int ownAdds=0,ownRemoves=0,reads=0,depth=0,maxDepth=0; TArray<TSubclassOf<UFGRecipe>> available; std::function<void()> duringWrite;
 std::function<void()> duringOwnWrite;
 void OnOwnWrite(const TArray<TSubclassOf<UFGRecipe>>& recipes){if(duringOwnWrite&&std::any_of(recipes.begin(),recipes.end(),[](auto c){return c.Get()==&OwnClass;})){auto cb=std::exchange(duringOwnWrite,{});Origin origin(false);cb();}}
 static AFGRecipeManager* Get(UWorld* w){return w?w->manager:nullptr;} UWorld* GetWorld()const{return world;} bool HasAuthority()const{return authority;}
 bool IsRecipeAvailable(TSubclassOf<UFGRecipe> c){++reads;return std::find(available.begin(),available.end(),c)!=available.end();}
 void Seed(UClass* c){if(std::none_of(available.begin(),available.end(),[c](auto x){return x.Get()==c;}))available.push_back(c);}
 void AddAvailableRecipe(TSubclassOf<UFGRecipe> c){AddAvailableRecipes({c});}
 void AddAvailableRecipes(TArray<TSubclassOf<UFGRecipe>> recipes){++depth;maxDepth=std::max(depth,maxDepth);for(auto c:recipes){if(InProduction){if(c.Get()==&OwnClass)++ProductionOwnAdds;else ++ForbiddenWrites;}if(c.Get()==&OwnClass)++ownAdds;if(!reject)Seed(c.Get());}OnOwnWrite(recipes);if(duringWrite){auto cb=std::exchange(duringWrite,{});cb();}Fire(AddHooks,this,recipes);--depth;}
 void RemoveAvailableRecipes(const TArray<TSubclassOf<UFGRecipe>>& recipes){++depth;maxDepth=std::max(depth,maxDepth);auto copy=recipes;for(auto c:copy){if(InProduction){if(c.Get()==&OwnClass)++ProductionOwnRemoves;else ++ForbiddenWrites;}if(c.Get()==&OwnClass)++ownRemoves;if(!reject)available.erase(std::remove(available.begin(),available.end(),c),available.end());}OnOwnWrite(recipes);if(duringWrite){auto cb=std::exchange(duringWrite,{});cb();}Fire(RemoveHooks,this,recipes);--depth;}
 void ResetAllRecipes(){RemoveAvailableRecipes(available);} // sentinel composition, NOT SDK implementation
};
